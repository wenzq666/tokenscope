#include <windows.h>
#include "version.h"

1 RT_MANIFEST "app.manifest"

#ifdef TOKENSCOPE_HAVE_ICON
101 ICON "app.ico"
#endif

1 VERSIONINFO
FILEVERSION TOKENSCOPE_VERSION_MAJOR,TOKENSCOPE_VERSION_MINOR,TOKENSCOPE_VERSION_PATCH,0
PRODUCTVERSION TOKENSCOPE_VERSION_MAJOR,TOKENSCOPE_VERSION_MINOR,TOKENSCOPE_VERSION_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TokenScope local agent usage statistics\0"
            VALUE "FileVersion", TOKENSCOPE_VERSION_STRING "\0"
            VALUE "InternalName", "TokenScope\0"
            VALUE "OriginalFilename", "TokenScope.exe\0"
            VALUE "ProductName", "TokenScope\0"
            VALUE "ProductVersion", TOKENSCOPE_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

